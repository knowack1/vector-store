+use crate::query::term_query::TermScorer;
+use crate::query::Scorer;
+use crate::{DocId, DocSet, Score, TERMINATED};
+
+/// A range of doc ids `[target, last_doc]` inside which every clause stays in one block, so
+/// that each clause's block max bounds its score over the whole range.
+struct Window {
+    last_doc: DocId,
+    /// `remaining_max[i]` bounds the summed score of the clauses after clause `i`.
+    remaining_max: Vec<Score>,
+}
+
+enum Candidate {
+    Matched(Score),
+    Pruned,
+    Missed(DocId),
+}
+
+impl Window {
+    fn new(num_clauses: usize) -> Window {
+        Window {
+            last_doc: TERMINATED,
+            remaining_max: vec![0.0; num_clauses],
+        }
+    }
+
+    /// Moves every clause's skip reader to the block holding `target` without decoding it, and
+    /// returns the sum of the block maxima over the new window.
+    fn shallow_seek(&mut self, scorers: &mut [TermScorer], target: DocId) -> Score {
+        self.last_doc = TERMINATED;
+        let mut window_max: Score = 0.0;
+        for (ord, scorer) in scorers.iter_mut().enumerate().rev() {
+            scorer.seek_block(target);
+            self.last_doc = self.last_doc.min(scorer.last_doc_in_block());
+            self.remaining_max[ord] = window_max;
+            window_max += scorer.block_max_score();
+        }
+        window_max
+    }
+
+    fn doc_after(&self) -> DocId {
+        if self.last_doc == TERMINATED {
+            TERMINATED
+        } else {
+            self.last_doc + 1
+        }
+    }
+
+    fn contains(&self, doc: DocId) -> bool {
+        doc <= self.last_doc && doc != TERMINATED
+    }
+}
+
+/// Top-k walk over the intersection of two or more term scorers, after Lucene's block-max
+/// conjunction.
+///
+/// - At a candidate, every clause moves its skip reader to the block holding it without decoding
+///   (`seek_block`). The window ends at the first `last_doc_in_block` among them.
+/// - When the sum of the clauses' block maxima cannot beat the threshold, the whole window is
+///   skipped.
+/// - Otherwise the walk leapfrogs inside the window. The lead, the cheapest clause, is scored
+///   first, and a candidate is dropped as soon as its partial score plus the remaining clauses'
+///   block maxima cannot beat the threshold, before those clauses are sought.
+///
+/// Clauses are ordered and their scores summed as in `intersect_scorers` and
+/// `Intersection::score`, so every score passed to `callback` is bit-identical to the unpruned
+/// walk's. Documents are passed in increasing order, and only when their score is above the
+/// threshold.
+pub(crate) fn block_max_conjunction(
+    mut scorers: Vec<TermScorer>,
+    mut threshold: Score,
+    callback: &mut dyn FnMut(DocId, Score) -> Score,
+) {
+    debug_assert!(scorers.len() >= 2);
+    scorers.sort_by_key(|scorer| scorer.cost());
+    let mut window = Window::new(scorers.len());
+    let mut clause_scores: Vec<Score> = vec![0.0; scorers.len()];
+    let mut target = scorers.iter().map(DocSet::doc).max().unwrap_or(TERMINATED);
+    while target != TERMINATED {
+        let window_max = window.shallow_seek(&mut scorers, target);
+        target = if window_max <= threshold {
+            window.doc_after()
+        } else {
+            walk_window(
+                &mut scorers,
+                target,
+                &window,
+                &mut clause_scores,
+                &mut threshold,
+                callback,
+            )
+        };
+    }
+}
+
+/// Walks the candidates of `window` from `target` and returns the first doc id past it.
+///
+/// On entry and on return, no clause is positioned past the returned doc id, which is what
+/// `seek` requires of the next window's target.
+fn walk_window(
+    scorers: &mut [TermScorer],
+    target: DocId,
+    window: &Window,
+    clause_scores: &mut [Score],
+    threshold: &mut Score,
+    callback: &mut dyn FnMut(DocId, Score) -> Score,
+) -> DocId {
+    let mut doc = scorers[0].seek(target);
+    while window.contains(doc) {
+        doc = match align_and_score(scorers, doc, window, clause_scores, *threshold) {
+            Candidate::Matched(score) => {
+                if score > *threshold {
+                    *threshold = callback(doc, score);
+                }
+                scorers[0].advance()
+            }
+            Candidate::Pruned => scorers[0].advance(),
+            Candidate::Missed(next) if window.contains(next) => scorers[0].seek(next),
+            Candidate::Missed(next) => return next,
+        };
+    }
+    doc
+}
+
+/// Scores the lead on `doc`, then seeks and scores the other clauses one by one, stopping as
+/// soon as the candidate is missing from a clause or can no longer beat `threshold`.
+fn align_and_score(
+    scorers: &mut [TermScorer],
+    doc: DocId,
+    window: &Window,
+    clause_scores: &mut [Score],
+    threshold: Score,
+) -> Candidate {
+    let last_ord = scorers.len() - 1;
+    let mut partial_score: Score = 0.0;
+    for (ord, scorer) in scorers.iter_mut().enumerate() {
+        if ord > 0 {
+            let clause_doc = scorer.seek(doc);
+            if clause_doc != doc {
+                return Candidate::Missed(clause_doc);
+            }
+        }
+        clause_scores[ord] = scorer.score();
+        partial_score += clause_scores[ord];
+        if ord < last_ord && partial_score + window.remaining_max[ord] <= threshold {
+            return Candidate::Pruned;
+        }
+    }
+    Candidate::Matched(intersection_score(clause_scores))
+}
+
+/// The sum in the association `Intersection::score` uses: `left + right + sum(others)`.
+fn intersection_score(clause_scores: &[Score]) -> Score {
+    clause_scores[0] + clause_scores[1] + clause_scores[2..].iter().sum::<Score>()
+}
