+/// Keeps two or more MUST term scorers unboxed, so that `for_each_pruning` can walk them with
+/// the block-max conjunction. Block-max scores are only meaningful when term frequencies are read.
+/// Returns the scorers unchanged for any other shape.
+fn term_intersection(
+    must_scorers: Vec<Box<dyn Scorer>>,
+    removed_all_scorer_count: usize,
+) -> Result<SpecializedScorer, Vec<Box<dyn Scorer>>> {
+    let is_prunable = removed_all_scorer_count == 0
+        && must_scorers.len() >= 2
+        && must_scorers
+            .iter()
+            .all(|scorer| is_term_scorer_reading_freqs(scorer.as_ref()));
+    if !is_prunable {
+        return Err(must_scorers);
+    }
+    let term_scorers = must_scorers
+        .into_iter()
+        .map(|scorer| *(scorer.downcast::<TermScorer>().map_err(|_| ()).unwrap()))
+        .collect();
+    Ok(SpecializedScorer::TermIntersection(term_scorers))
+}
+
+fn is_term_scorer_reading_freqs(scorer: &dyn Scorer) -> bool {
+    scorer
+        .downcast_ref::<TermScorer>()
+        .is_some_and(|term_scorer| term_scorer.freq_reading_option() == FreqReadingOption::ReadFreq)
+}
