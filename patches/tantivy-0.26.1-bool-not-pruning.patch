+#[cfg(test)]
+mod tests {
+    use std::collections::HashSet;
+
+    use rand::rngs::StdRng;
+    use rand::{Rng, SeedableRng};
+
+    use super::assert_same_top_k;
+    use crate::collector::{Count, TopDocs};
+    use crate::indexer::NoMergePolicy;
+    use crate::query::{BooleanQuery, EnableScoring, Occur, Query, TermQuery};
+    use crate::schema::{Field, IndexRecordOption, Schema, INDEXED, TEXT};
+    use crate::{DocAddress, Index, IndexWriter, Score, Searcher, Term};
+
+    const NUM_SEGMENTS: u64 = 3;
+    const DOCS_PER_SEGMENT: u64 = 3_000;
+    const TOP_KS: [usize; 4] = [1, 5, 10, 1000];
+    const MIN_MATCHES: usize = 4 * 128;
+
+    struct TestIndex {
+        index: Index,
+        text: Field,
+        alive_docs: Vec<HashSet<&'static str>>,
+    }
+
+    struct Case {
+        clauses: &'static [(Occur, &'static str)],
+        matches: fn(&HashSet<&'static str>) -> bool,
+    }
+
+    fn cases() -> Vec<Case> {
+        vec![
+            Case {
+                clauses: &[(Occur::Should, "a"), (Occur::MustNot, "b")],
+                matches: |words| words.contains("a") && !words.contains("b"),
+            },
+            Case {
+                clauses: &[(Occur::Must, "a"), (Occur::MustNot, "b")],
+                matches: |words| words.contains("a") && !words.contains("b"),
+            },
+            Case {
+                clauses: &[
+                    (Occur::Should, "a"),
+                    (Occur::Should, "b"),
+                    (Occur::MustNot, "c"),
+                ],
+                matches: |words| {
+                    (words.contains("a") || words.contains("b")) && !words.contains("c")
+                },
+            },
+            Case {
+                clauses: &[
+                    (Occur::Must, "a"),
+                    (Occur::MustNot, "b"),
+                    (Occur::MustNot, "c"),
+                ],
+                matches: |words| {
+                    words.contains("a") && !words.contains("b") && !words.contains("c")
+                },
+            },
+            Case {
+                clauses: &[
+                    (Occur::Must, "a"),
+                    (Occur::Must, "c"),
+                    (Occur::MustNot, "b"),
+                ],
+                matches: |words| words.contains("a") && words.contains("c") && !words.contains("b"),
+            },
+        ]
+    }
+
+    fn random_term_freq(rng: &mut StdRng, probability: f64) -> usize {
+        if rng.random_bool(probability) {
+            rng.random_range(1..=4)
+        } else {
+            0
+        }
+    }
+
+    /// `b` is likelier in documents with a high `a` frequency, so excluding `b` removes
+    /// many of the best `a` documents: an excluded document must never raise the threshold.
+    fn random_doc_words(rng: &mut StdRng) -> Vec<&'static str> {
+        let a_freq = random_term_freq(rng, 0.6);
+        let b_probability = if a_freq >= 3 { 0.8 } else { 0.3 };
+        let b_freq = random_term_freq(rng, b_probability);
+        let c_freq = random_term_freq(rng, 0.3);
+        let filler_len = rng.random_range(0..30);
+        [
+            ("a", a_freq),
+            ("b", b_freq),
+            ("c", c_freq),
+            ("x", filler_len),
+        ]
+        .into_iter()
+        .flat_map(|(word, freq)| std::iter::repeat_n(word, freq))
+        .collect()
+    }
+
+    fn is_deleted(doc_id: u64, delete_every: Option<u64>) -> bool {
+        delete_every.is_some_and(|every| doc_id % every == 0)
+    }
+
+    fn build_index(delete_every: Option<u64>) -> crate::Result<TestIndex> {
+        let mut schema_builder = Schema::builder();
+        let text = schema_builder.add_text_field("text", TEXT);
+        let id = schema_builder.add_u64_field("id", INDEXED);
+        let index = Index::create_in_ram(schema_builder.build());
+        let mut writer: IndexWriter = index.writer_for_tests()?;
+        writer.set_merge_policy(Box::new(NoMergePolicy));
+        let mut rng = StdRng::seed_from_u64(42);
+        let mut alive_docs = Vec::new();
+        for doc_id in 0..NUM_SEGMENTS * DOCS_PER_SEGMENT {
+            let words = random_doc_words(&mut rng);
+            writer.add_document(doc!(text => words.join(" "), id => doc_id))?;
+            if !is_deleted(doc_id, delete_every) {
+                alive_docs.push(words.into_iter().collect());
+            }
+            if (doc_id + 1) % DOCS_PER_SEGMENT == 0 {
+                writer.commit()?;
+            }
+        }
+        for doc_id in 0..NUM_SEGMENTS * DOCS_PER_SEGMENT {
+            if is_deleted(doc_id, delete_every) {
+                writer.delete_term(Term::from_field_u64(id, doc_id));
+            }
+        }
+        writer.commit()?;
+        Ok(TestIndex {
+            index,
+            text,
+            alive_docs,
+        })
+    }
+
+    fn boolean_query(text: Field, clauses: &[(Occur, &str)]) -> BooleanQuery {
+        BooleanQuery::new(
+            clauses
+                .iter()
+                .map(|&(occur, word)| {
+                    let term = Term::from_field_text(text, word);
+                    let query: Box<dyn Query> =
+                        Box::new(TermQuery::new(term, IndexRecordOption::WithFreqs));
+                    (occur, query)
+                })
+                .collect(),
+        )
+    }
+
+    fn all_alive_scored_docs(
+        searcher: &Searcher,
+        query: &dyn Query,
+    ) -> crate::Result<Vec<(Score, DocAddress)>> {
+        let weight = query.weight(EnableScoring::enabled_from_searcher(searcher))?;
+        let mut hits = Vec::new();
+        for (segment_ord, reader) in searcher.segment_readers().iter().enumerate() {
+            weight.for_each(reader, &mut |doc, score| {
+                if !reader.is_deleted(doc) {
+                    hits.push((score, DocAddress::new(segment_ord as u32, doc)));
+                }
+            })?;
+        }
+        Ok(hits)
+    }
+
+    fn naive_top_k(mut hits: Vec<(Score, DocAddress)>, k: usize) -> Vec<(Score, DocAddress)> {
+        hits.sort_by(|left, right| right.0.total_cmp(&left.0).then(left.1.cmp(&right.1)));
+        hits.truncate(k);
+        hits
+    }
+
+    fn check_pruned_top_k_matches_full_walk(delete_every: Option<u64>) -> crate::Result<()> {
+        let test_index = build_index(delete_every)?;
+        let searcher = test_index.index.reader()?.searcher();
+        assert_eq!(searcher.segment_readers().len() as u64, NUM_SEGMENTS);
+        let has_deletes = searcher.segment_readers().iter().all(|r| r.has_deletes());
+        assert_eq!(has_deletes, delete_every.is_some());
+        for case in cases() {
+            let query = boolean_query(test_index.text, case.clauses);
+            let all_hits = all_alive_scored_docs(&searcher, &query)?;
+            let expected_count = test_index
+                .alive_docs
+                .iter()
+                .filter(|words| (case.matches)(words))
+                .count();
+            assert!(
+                expected_count >= MIN_MATCHES,
+                "{:?} {expected_count}",
+                case.clauses
+            );
+            assert_eq!(all_hits.len(), expected_count, "{:?}", case.clauses);
+            assert_eq!(searcher.search(&query, &Count)?, expected_count);
+            for k in TOP_KS {
+                let pruned = searcher.search(&query, &TopDocs::with_limit(k).order_by_score())?;
+                let naive = naive_top_k(all_hits.clone(), k);
+                let context = format!("{:?} k={k}", case.clauses);
+                assert_same_top_k(&pruned, &naive, k, &context);
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_excluding_pruning_matches_full_walk() -> crate::Result<()> {
+        check_pruned_top_k_matches_full_walk(None)
+    }
+
+    #[test]
+    fn test_excluding_pruning_matches_full_walk_with_deleted_docs() -> crate::Result<()> {
+        check_pruned_top_k_matches_full_walk(Some(7))
+    }
+}
