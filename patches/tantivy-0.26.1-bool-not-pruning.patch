+/// The include part of a boolean query and its `MustNot` scorers, before they are
+/// combined into an `Exclude`.
+struct ScorerParts {
+    include: SpecializedScorer,
+    exclude: Vec<Box<dyn Scorer>>,
+}
+
+impl ScorerParts {
+    fn empty() -> ScorerParts {
+        ScorerParts {
+            include: SpecializedScorer::Other(Box::new(EmptyScorer)),
+            exclude: Vec::new(),
+        }
+    }
+
+    fn into_specialized_scorer<TScoreCombiner: ScoreCombiner>(
+        self,
+        score_combiner_fn: impl Fn() -> TScoreCombiner,
+        num_docs: u32,
+    ) -> SpecializedScorer {
+        if self.exclude.is_empty() {
+            return self.include;
+        }
+        let include_scorer_boxed = into_box_scorer(self.include, score_combiner_fn, num_docs);
+        let exclusion = ExclusionScorers::new(self.exclude);
+        SpecializedScorer::Other(exclusion.exclude_from(include_scorer_boxed))
+    }
+
+    /// Splits off a block-max prunable include when there is something to exclude.
+    /// Returns the parts unchanged otherwise.
+    fn into_excluding_pruner(self) -> Result<(PrunableInclude, ExclusionScorers), ScorerParts> {
+        if self.exclude.is_empty() {
+            return Err(self);
+        }
+        match prunable_include(self.include) {
+            Ok(include) => Ok((include, ExclusionScorers::new(self.exclude))),
+            Err(include) => Err(ScorerParts {
+                include,
+                exclude: self.exclude,
+            }),
+        }
+    }
+}
+
+/// Block-max scores are only meaningful when term frequencies are read.
+fn prunable_include(include: SpecializedScorer) -> Result<PrunableInclude, SpecializedScorer> {
+    match include {
+        SpecializedScorer::TermUnion(term_scorers) => Ok(PrunableInclude::TermUnion(term_scorers)),
+        SpecializedScorer::Other(scorer) => match scorer.downcast::<TermScorer>() {
+            Ok(term_scorer) if term_scorer.freq_reading_option() == FreqReadingOption::ReadFreq => {
+                Ok(PrunableInclude::SingleTerm(term_scorer))
+            }
+            Ok(term_scorer) => Err(SpecializedScorer::Other(term_scorer)),
+            Err(scorer) => Err(SpecializedScorer::Other(scorer)),
+        },
+    }
+}
