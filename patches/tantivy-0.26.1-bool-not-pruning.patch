+use crate::query::boolean_query::{block_wand, block_wand_single_scorer};
+use crate::query::term_query::TermScorer;
+use crate::query::{Exclude, ExclusionSet, Scorer};
+use crate::{DocId, Score};
+
+/// The include part of a boolean query that block-max WAND can walk.
+pub(crate) enum PrunableInclude {
+    SingleTerm(Box<TermScorer>),
+    TermUnion(Vec<TermScorer>),
+}
+
+/// The `MustNot` scorers of a boolean query, keeping the concrete `TermScorer`
+/// type for a single term so that probing it avoids dynamic dispatch.
+pub(crate) enum ExclusionScorers {
+    Term(Box<TermScorer>),
+    Other(Box<dyn Scorer>),
+    Many(Vec<Box<dyn Scorer>>),
+}
+
+impl ExclusionScorers {
+    pub(crate) fn new(mut scorers: Vec<Box<dyn Scorer>>) -> ExclusionScorers {
+        if scorers.len() != 1 {
+            return ExclusionScorers::Many(scorers);
+        }
+        match scorers.pop().unwrap().downcast::<TermScorer>() {
+            Ok(term_scorer) => ExclusionScorers::Term(term_scorer),
+            Err(scorer) => ExclusionScorers::Other(scorer),
+        }
+    }
+
+    pub(crate) fn exclude_from(self, include: Box<dyn Scorer>) -> Box<dyn Scorer> {
+        match self {
+            ExclusionScorers::Term(scorer) => Box::new(Exclude::new(include, *scorer)),
+            ExclusionScorers::Other(scorer) => Box::new(Exclude::new(include, scorer)),
+            ExclusionScorers::Many(scorers) => Box::new(Exclude::new(include, scorers)),
+        }
+    }
+}
+
+impl ExclusionSet for ExclusionScorers {
+    #[inline]
+    fn contains(&mut self, doc: DocId) -> bool {
+        match self {
+            ExclusionScorers::Term(scorer) => ExclusionSet::contains(&mut **scorer, doc),
+            ExclusionScorers::Other(scorer) => ExclusionSet::contains(scorer, doc),
+            ExclusionScorers::Many(scorers) => ExclusionSet::contains(scorers, doc),
+        }
+    }
+}
+
+/// Runs block-max WAND over `include` and passes on to `callback` only the documents
+/// that are not in `exclusion`.
+///
+/// The exclusion set cannot change a score, so it is probed last: only for the documents
+/// that already beat the threshold. Both walkers emit strictly increasing doc ids, which is
+/// the contract `ExclusionSet::contains` relies on. This mirrors how deleted documents are
+/// filtered in the callback of `SortBySimilarityScore::collect_segment_top_k`.
+pub(crate) fn for_each_pruning_excluding(
+    include: PrunableInclude,
+    mut exclusion: impl ExclusionSet,
+    threshold: Score,
+    callback: &mut dyn FnMut(DocId, Score) -> Score,
+) {
+    let mut current_threshold = threshold;
+    let mut filtered_callback = |doc: DocId, score: Score| {
+        if exclusion.contains(doc) {
+            return current_threshold;
+        }
+        current_threshold = callback(doc, score);
+        current_threshold
+    };
+    match include {
+        PrunableInclude::SingleTerm(scorer) => {
+            block_wand_single_scorer(*scorer, threshold, &mut filtered_callback)
+        }
+        PrunableInclude::TermUnion(scorers) => {
+            block_wand(scorers, threshold, &mut filtered_callback)
+        }
+    }
+}
+
+#[cfg(test)]
+fn nearly_equals(left: Score, right: Score) -> bool {
+    (left - right).abs() <= 0.0001 * (left + right).abs()
+}
+
+/// Asserts that two top-k lists sorted by descending score are the same up to ties:
+/// equal hit counts, equal score lists, and the same documents apart from those tied
+/// with the k-th score when the list is full.
+#[cfg(test)]
+pub(crate) fn assert_same_top_k<D: Copy + Ord + std::fmt::Debug>(
+    pruned: &[(Score, D)],
+    naive: &[(Score, D)],
+    k: usize,
+    context: &str,
+) {
+    assert_eq!(pruned.len(), naive.len(), "{context}: hit counts differ");
+    for (&(pruned_score, _), &(naive_score, _)) in pruned.iter().zip(naive) {
+        assert!(
+            nearly_equals(pruned_score, naive_score),
+            "{context}: score lists differ\npruned {pruned:?}\nnaive {naive:?}"
+        );
+    }
+    let Some(&(kth_score, _)) = naive.last() else {
+        return;
+    };
+    let is_tie_at_kth = |score: Score| naive.len() == k && nearly_equals(score, kth_score);
+    let docs_beating_ties = |hits: &[(Score, D)]| {
+        let mut docs: Vec<D> = hits
+            .iter()
+            .filter(|(score, _)| !is_tie_at_kth(*score))
+            .map(|&(_, doc)| doc)
+            .collect();
+        docs.sort();
+        docs
+    };
+    assert_eq!(
+        docs_beating_ties(pruned),
+        docs_beating_ties(naive),
+        "{context}: documents differ beyond ties"
+    );
+}
